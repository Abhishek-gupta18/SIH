services:
  db:
    image: postgres:16
    container_name: bhumitwin_db
    restart: unless-stopped
    environment:
      POSTGRES_USER: bhumitwin
      POSTGRES_PASSWORD: bhumitwin
      POSTGRES_DB: bhumitwin
    volumes:
      - pg_data:/var/lib/postgresql/data
    ports:
      - "5432:5432"

volumes:
  pg_data: